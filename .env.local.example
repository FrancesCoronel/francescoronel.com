# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Cal.com API (for live mentoring session feed)
CAL_COM_API_KEY=
# Your own Cal.com email, so the feed shows the attendee's name instead of yours
NEXT_PUBLIC_CAL_EMAIL=

# Calendly API (for backfilling historical session data)
CALENDLY_API_KEY=

# Buttondown (newsletter subscriptions)
BUTTONDOWN_API_KEY=

# Slack Incoming Webhook (notifies on new newsletter subscribers)
SLACK_WEBHOOK_URL=

# GitHub token (optional; raises the API rate limit for repo stars and cards on the home, work and post pages)
GITHUB_TOKEN=

# Vercel Blob (for image hosting)
BLOB_READ_WRITE_TOKEN=

# Sentry error monitoring — DSN from https://fvcproductions.sentry.io/settings/projects/fvcproductions/keys/
NEXT_PUBLIC_SENTRY_DSN=https://cd17e1dccf534b1f98791087b0da9c02@o188643.ingest.us.sentry.io/1286368
# Auth token for uploading source maps during CI builds — https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=

# Google Search Console — HTML tag value from Search Console → Settings → Ownership verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Webflow API (for content export script — not needed post-migration)
# WEBFLOW_API_TOKEN=
