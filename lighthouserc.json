{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "localhost",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/about",
        "http://localhost:3000/posts",
        "http://localhost:3000/posts/i-think-im-becoming-a-cracked-engineer",
        "http://localhost:3000/organizations/slack",
        "http://localhost:3000/contact"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "color-contrast": ["error", { "minScore": 1 }],

        "errors-in-console": "off",
        "heading-order": "off",
        "image-redundant-alt": "off",
        "unsized-images": "off",
        "redirects": "off",
        "image-delivery-insight": "off",
        "legacy-javascript-insight": "off",
        "network-dependency-tree-insight": "off",
        "lcp-discovery-insight": "off",
        "forced-reflow-insight": "off",
        "document-latency-insight": "off",
        "offscreen-images": "off",

        "largest-contentful-paint": ["warn", { "minScore": 0.3 }],
        "interactive": ["warn", { "minScore": 0.4 }],
        "max-potential-fid": ["warn", { "minScore": 0.2 }],
        "total-blocking-time": ["warn", { "minScore": 0.5 }],
        "unused-javascript": ["warn", { "minScore": 0.3 }],
        "uses-optimized-images": ["warn", { "minScore": 0.5 }],
        "uses-responsive-images": ["warn", { "minScore": 0.5 }],
        "render-blocking-resources": ["warn", { "minScore": 0.5 }],
        "render-blocking-insight": ["warn", { "minScore": 0.5 }],
        "dom-size": ["warn", { "minScore": 0.5 }],
        "dom-size-insight": ["warn", { "minScore": 0.5 }],
        "modern-image-formats": ["warn", { "minScore": 0.5 }],
        "legacy-javascript": ["warn", { "minScore": 0.5 }],
        "uses-long-cache-ttl": ["warn", { "minScore": 0.5 }],
        "image-aspect-ratio": ["warn", { "minScore": 0.5 }],
        "image-size-responsive": ["warn", { "minScore": 0.5 }],
        "valid-source-maps": ["warn", { "minScore": 0.3 }]
      }
    }
  }
}
