{
  "name": "francescoronel.com",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "export:webflow": "npx tsx scripts/migrations/export-webflow.ts",
    "import:wordpress": "npx tsx scripts/migrations/import-wordpress.ts",
    "migrate:images": "npx tsx scripts/migrations/migrate-images.ts",
    "postbuild": "node scripts/build-search-index.mjs",
    "lighthouse": "npx @lhci/cli autorun",
    "lighthouse:local": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html --chrome-flags='--headless=new'",
    "audit:a11y": "npx pa11y-ci --config .pa11yci.json",
    "audit:full": "npx unlighthouse --site http://localhost:3000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --project storybook --run",
    "test:coverage": "vitest --project unit --run --coverage",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lint:md": "markdownlint-cli2 \"content/posts/**/*.mdx\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:components": "playwright test e2e/components.spec.ts",
    "test:e2e:visual": "VISUAL=1 playwright test e2e/visual.spec.ts --project=visual-desktop",
    "test:e2e:visual:mobile": "VISUAL=1 playwright test e2e/visual.spec.ts --project=visual-mobile",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.56.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.2",
    "next-cloudinary": "^6.19.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-tweet": "3.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "0.4.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "15.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^27.4.0",
    "markdownlint-cli2": "^0.23.1",
    "pagefind": "^1.4.0",
    "playwright": "^1.58.2",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "postcss": "^8.5.20",
    "esbuild": "^0.28.1",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.1"
    },
    "markdownlint-cli2": {
      "smol-toml": "^1.7.1"
    }
  }
}
